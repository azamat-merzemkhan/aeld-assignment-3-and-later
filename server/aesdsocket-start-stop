#!/bin/sh
case "$1" in
    start)
        echo "Starting aesdsocket"
        start-stop-daemon -S -q -x /usr/bin/aesdsocket -- -d
        ;;
    stop)
        echo "Stopping aesdsocket"
        start-stop-daemon -K -q -s TERM -x /usr/bin/aesdsocket
        count=0
        while pidof aesdsocket >/dev/null && [ "$count" -lt 50 ]; do
            sleep 0.1
            count=$((count + 1))
        done
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
